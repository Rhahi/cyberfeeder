{
  "manifest_version": 3,
  "name": "Cyberfeeder",
  "version": "5.4.1",
  "description": "UI improvements for jinteki.net",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/JINTEKI_16.png",
    "32": "icons/JINTEKI_32.png",
    "48": "icons/JINTEKI_48.png",
    "96": "icons/JINTEKI_96.png",
    "128": "icons/JINTEKI_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jinteki.net/*"
      ],
      "js": [
        "js/jnet.js"
      ]
    }
  ],
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.jinteki.net/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "html/sidebar.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/JINTEKI_16.png",
      "32": "icons/JINTEKI_32.png",
      "48": "icons/JINTEKI_48.png",
      "96": "icons/JINTEKI_96.png",
      "128": "icons/JINTEKI_128.png"
    },
    "default_title": "Click: Toggle panel\n(Reload features and injection outside of jinteki.net are in the panel's Settings tab)"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "webfonts/fa-solid-900.woff2",
        "css/fontawesome.min.css",
        "css/solid.min.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
